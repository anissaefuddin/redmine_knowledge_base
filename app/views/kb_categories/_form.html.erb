<%= error_messages_for 'category' %>

<div class="box tabular">
  <p><%= f.text_field :name, required: true, size: 60 %></p>
  <p><%= f.text_area :description, rows: 3, cols: 60 %></p>
  <p>
    <%= f.select :parent_id,
                  options_for_select([[l(:label_kb_no_parent), nil]] + kb_category_tree_options(exclude: @category.persisted? ? @category : nil), f.object.parent_id) %>
  </p>
  <p>
    <%= f.text_field :position, size: 5 %>
    <em class="info"><%= l(:text_kb_position_hint) %></em>
  </p>
</div>

<% if @all_groups %>
  <fieldset class="box">
    <legend><%= l(:label_kb_restricted_to_groups) %></legend>
    <p class="info"><%= l(:text_kb_group_restriction_hint) %></p>
    <% @all_groups.each do |group| %>
      <label class="block">
        <%= check_box_tag 'group_ids[]', group.id, @category.group_ids.include?(group.id) %>
        <%= group.name %>
      </label>
    <% end %>
  </fieldset>
<% end %>

<% if @all_roles %>
  <fieldset class="box">
    <legend><%= l(:label_kb_restricted_to_roles) %></legend>
    <p class="info"><%= l(:text_kb_role_restriction_hint) %></p>
    <% @all_roles.each do |role| %>
      <label class="block">
        <%= check_box_tag 'role_ids[]', role.id, @category.role_ids.include?(role.id) %>
        <%= role.name %>
      </label>
    <% end %>
  </fieldset>
<% end %>
