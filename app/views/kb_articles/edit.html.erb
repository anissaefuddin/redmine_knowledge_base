<div class="kb-breadcrumb">
  <%= link_to l(:label_knowledge_base), knowledge_base_path %>
  <% @article.kb_category.self_and_ancestors.each do |c| %> / <%= link_to c.name, kb_category_path(c) %><% end %>
  / <%= link_to @article.title, kb_article_path(@article) %>
  / <%= l(:button_edit) %>
</div>

<h2><%= l(:label_kb_edit_article) %>: <%= @article.title %></h2>

<%= labelled_form_for :kb_article, @article, url: kb_article_path(@article), html: { method: :put, multipart: true, id: 'kb-article-form' } do |f| %>
  <%= render partial: 'form', locals: { f: f } %>
  <div class="kb-form-actions">
    <%= submit_tag @article.published? ? l(:button_kb_save_changes) : l(:button_kb_save_draft), id: 'kb-article-submit' %>
    <%= link_to l(:button_cancel), kb_article_path(@article) %>
  </div>
<% end %>

<script>
  (function() {
    var submitBtn = document.getElementById('kb-article-submit');
    var radios = document.querySelectorAll('.kb-status-radio');
    var labels = { draft: <%= l(:button_kb_save_draft).to_json.html_safe %>, published: <%= l(:button_kb_save_changes).to_json.html_safe %> };
    radios.forEach(function(radio) {
      radio.addEventListener('change', function() {
        if (radio.checked) { submitBtn.value = labels[radio.value] || submitBtn.value; }
      });
    });
  })();
</script>

<% html_title l(:label_kb_edit_article), @article.title, l(:label_knowledge_base) %>
