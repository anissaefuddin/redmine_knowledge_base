<%= error_messages_for 'article' %>

<div class="kb-form-title-row">
  <%= f.text_field :icon, class: 'kb-form-icon-input', placeholder: '🙂', maxlength: 8, title: l(:text_kb_icon_hint) %>
  <%= f.text_field :title, required: true, class: 'kb-form-title-input', placeholder: l(:label_kb_article) %>
</div>

<div class="kb-form-meta-grid">
  <div class="field">
    <label><%= l(:label_kb_category) %></label>
    <%= f.select :kb_category_id, options_for_select(kb_category_tree_options, f.object.kb_category_id), {}, required: true %>
  </div>
  <div class="field">
    <label id="kb-status-label"><%= l(:field_status) %></label>
    <div class="kb-status-toggle" role="radiogroup" aria-labelledby="kb-status-label">
      <label class="inline">
        <%= f.radio_button :status, 'draft', class: 'kb-status-radio' %> <%= l(:label_kb_status_draft) %>
      </label>
      <label class="inline">
        <%= f.radio_button :status, 'published', class: 'kb-status-radio' %> <%= l(:label_kb_status_published) %>
      </label>
    </div>
  </div>
  <div class="field">
    <label><%= l(:label_kb_tag_plural) %></label>
    <div class="kb-tag-chip-picker" id="kb-tag-chip-picker">
      <% KbTag.sorted.each do |tag| %>
        <label class="kb-tag-chip-toggle" data-tag-id="<%= tag.id %>">
          <%= check_box_tag 'kb_article[tag_ids][]', tag.id, @article.tag_ids.include?(tag.id),
                            id: "kb_article_tag_ids_#{tag.id}", class: 'kb-tag-chip-checkbox' %>
          <span class="tag tag-outline"><%= tag.name %></span>
        </label>
      <% end %>
      <%= hidden_field_tag 'kb_article[tag_ids][]', '' %>
      <% if kb_add_articles? || kb_edit_article?(@article) %>
        <span class="kb-tag-quick-create">
          <%= text_field_tag :kb_new_tag_name, nil, id: 'kb-new-tag-name', placeholder: l(:label_kb_new_tag), size: 12 %>
          <button type="button" id="kb-new-tag-btn" class="button-small"><%= l(:button_kb_add) %></button>
        </span>
      <% end %>
    </div>
  </div>
</div>

<script>
  (function () {
    var input = document.getElementById('kb-new-tag-name');
    var btn = document.getElementById('kb-new-tag-btn');
    var picker = document.getElementById('kb-tag-chip-picker');
    if (!btn || !picker) return;

    function createTag() {
      var name = input.value.trim();
      if (!name) return;
      btn.disabled = true;
      fetch(<%= quick_create_kb_tag_path.to_json.html_safe %>, {
        method: 'POST',
        credentials: 'same-origin',
        headers: {
          'Content-Type': 'application/x-www-form-urlencoded',
          'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').content,
          'Accept': 'application/json'
        },
        body: 'name=' + encodeURIComponent(name)
      }).then(function (res) { return res.json().then(function (json) { return { ok: res.ok, json: json }; }); })
        .then(function (result) {
          btn.disabled = false;
          if (!result.ok) {
            alert((result.json.errors || ['<%= j l(:error_kb_tag_create_failed) %>']).join(', '));
            return;
          }
          var label = document.createElement('label');
          label.className = 'kb-tag-chip-toggle';
          label.setAttribute('data-tag-id', result.json.id);
          label.innerHTML = '<input type="checkbox" name="kb_article[tag_ids][]" value="' + result.json.id +
            '" id="kb_article_tag_ids_' + result.json.id + '" class="kb-tag-chip-checkbox" checked>' +
            '<span class="tag tag-outline"></span>';
          label.querySelector('span').textContent = result.json.name;
          picker.insertBefore(label, document.getElementById('kb-new-tag-name').closest('.kb-tag-quick-create'));
          input.value = '';
          input.focus();
        });
    }

    btn.addEventListener('click', createTag);
    input.addEventListener('keydown', function (e) {
      if (e.key === 'Enter') { e.preventDefault(); createTag(); }
    });
  })();
</script>

<div class="box">
  <%
    # Lets the block editor preview an already-uploaded image (referenced in
    # saved content by plain filename, e.g. ![caption](photo.png)) without
    # needing the attachment's id from this editing session - it wasn't
    # uploaded in this session, so the id was never recorded client-side.
    existing_attachment_ids_by_filename = @article.attachments.to_h { |a| [a.filename, a.id] }
  %>
  <%= f.text_area :content, id: 'kb_article_content', rows: 20, cols: 100, class: 'wiki-edit', required: true,
                  data: { existing_attachments: existing_attachment_ids_by_filename.to_json } %>
</div>

<fieldset class="box">
  <legend><%= l(:label_attachment_plural) %></legend>
  <p class="info"><%= l(:text_kb_attachments_hint) %></p>
  <%= render partial: 'attachments/form', locals: { container: @article } %>
</fieldset>
