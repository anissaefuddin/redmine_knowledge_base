<div class="kb-breadcrumb">
  <%= link_to l(:label_knowledge_base), knowledge_base_path %>
  <% @breadcrumb.each do |c| %> / <%= link_to c.name, kb_category_path(c) %><% end %>
  / <%= link_to @article.title, kb_article_path(@article) %>
  / <%= l(:label_kb_history) %>
</div>

<h2><%= l(:label_kb_history) %>: <%= @article.title %></h2>

<% if @versions.any? %>
  <% version_options = @versions.map { |v| [l(:label_kb_version, number: v.version), v.version] } %>
  <%= form_tag diff_version_kb_article_path(@article), method: :get, class: 'kb-compare-form' do %>
    <span class="kb-filter-label"><%= l(:label_kb_compare) %>:</span>
    <%= select_tag :version, options_for_select(version_options, params[:version]) %>
    <span>&#8594;</span>
    <%= select_tag :compare_to, options_for_select([[l(:label_kb_current_version), '']] + version_options, params[:compare_to]) %>
    <%= submit_tag l(:label_kb_compare), class: 'button-small' %>
  <% end %>
<% end %>

<table class="list">
  <thead>
    <tr>
      <th><%= l(:field_version) %></th>
      <th><%= l(:field_updated_on) %></th>
      <th><%= l(:field_author) %></th>
      <th></th>
    </tr>
  </thead>
  <tbody>
    <tr>
      <td class="id"><%= link_to @article.version, kb_article_path(@article) %> (<%= l(:label_kb_current_version) %>)</td>
      <td class="updated_on"><%= format_time(@article.updated_at) %></td>
      <td class="author"><%= link_to_user(@article.updated_by || @article.author) %></td>
      <td></td>
    </tr>
    <% @versions.each do |version| %>
      <tr>
        <td class="id"><%= link_to version.version, version_kb_article_path(@article, version: version.version) %></td>
        <td class="updated_on"><%= format_time(version.created_at) %></td>
        <td class="author"><%= link_to_user version.author %></td>
        <td class="buttons">
          <%= link_to l(:label_kb_compare), diff_version_kb_article_path(@article, version: version.version) %>
          <% if kb_manage_articles? %>
            <%= button_to l(:button_kb_restore), restore_version_kb_article_path(@article, version: version.version),
                          method: :post, form_class: 'kb-inline-button',
                          data: { confirm: l(:text_kb_confirm_restore) } %>
          <% end %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>

<p><%= link_to l(:button_back), kb_article_path(@article) %></p>

<% html_title l(:label_kb_history), @article.title, l(:label_knowledge_base) %>
