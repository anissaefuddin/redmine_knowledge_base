<div class="kb-breadcrumb">
  <%= link_to l(:label_knowledge_base), knowledge_base_path %>
  <% @breadcrumb.each do |c| %> / <%= link_to c.name, kb_category_path(c) %><% end %>
  / <%= link_to @article.title, kb_article_path(@article) %>
  / <%= link_to l(:label_kb_history), history_kb_article_path(@article) %>
  / <%= l(:label_kb_compare) %>
</div>

<h2><%= l(:label_kb_compare) %>: <%= @article.title %></h2>

<p>
  <%= l(:label_kb_version, number: @from_version.version) %>
  <em>(<%= link_to_user(@from_version.author) %>, <%= format_time(@from_version.created_at) %>)</em>
  &#8594;
  <%= @to_label %>
  <em>(<%= link_to_user(@to_author) %>, <%= format_time(@to_date) %>)</em>
</p>

<pre class="text-diff"><%= Redmine::Helpers::Diff.new(@to_content, @from_version.content).to_html %></pre>

<p>
  <%= link_to l(:label_kb_history), history_kb_article_path(@article) %> |
  <%= link_to l(:button_back), kb_article_path(@article) %>
</p>

<% html_title l(:label_kb_compare), @article.title, l(:label_knowledge_base) %>
