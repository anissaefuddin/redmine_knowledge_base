<div class="contextual">
  <% if kb_manage_categories? %><%= link_to l(:label_kb_manage_categories), kb_categories_path %><% end %>
  <% if kb_manage_tags? %><%= link_to l(:label_kb_manage_tags), kb_tags_path %><% end %>
</div>

<h2><%= l(:label_knowledge_base) %></h2>

<%= form_tag(knowledge_base_path, method: :get, class: 'kb-search-form') do %>
  <%= text_field_tag :q, @q, size: 40, placeholder: l(:label_search) %>
  <%= submit_tag l(:button_apply), name: nil %>
<% end %>

<% if @articles %>
  <h3><%= l(:label_search) %>: "<%= @q %>"</h3>
  <% if @articles.any? %>
    <table class="list">
      <tbody>
        <% @articles.each do |article| %>
          <tr>
            <td><%= link_to article.title, kb_article_path(article) %></td>
            <td><span class="tag <%= kb_status_css_class(article) %>"><%= kb_status_label(article) %></span></td>
            <td><%= article.kb_category.name %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p class="nodata"><%= l(:label_no_data) %></p>
  <% end %>
  <hr>
<% end %>

<div class="kb-layout">
  <aside class="kb-sidebar">
    <div class="kb-sidebar-title"><%= l(:label_kb_category_plural) %></div>
    <% if @root_categories.blank? %>
      <p class="nodata"><%= l(:text_kb_no_categories) %></p>
    <% else %>
      <div class="kb-tree">
        <%= render partial: 'kb_categories/tree', locals: { nodes: @root_categories, counts: @counts_by_category_id, active_id: nil, depth: 0 } %>
      </div>
    <% end %>
  </aside>

  <main class="kb-main">
    <% if @pinned_articles.any? %>
      <div class="kb-sidebar-title"><%= l(:label_kb_pinned_articles) %></div>
      <div class="kb-pinned-grid">
        <% @pinned_articles.each do |article| %>
          <div class="kb-pinned-card">
            <div class="kb-pinned-card-category"><%= article.kb_category.name %></div>
            <h3><%= link_to article.title, kb_article_path(article) %></h3>
            <div class="kb-pinned-card-meta">
              <%= l(:label_kb_last_updated_by,
                    author: link_to_user(article.updated_by || article.author),
                    date: format_time(article.updated_at)).html_safe %>
              <% if kb_manage_articles? %> &middot; <span class="tag <%= kb_status_css_class(article) %>"><%= kb_status_label(article) %></span><% end %>
            </div>
            <% if article.tags.any? %>
              <div class="kb-pinned-card-tags">
                <% article.tags.each do |t| %><span class="tag tag-outline"><%= t.name %></span><% end %>
              </div>
            <% end %>
          </div>
        <% end %>
      </div>
    <% elsif kb_manage_articles? %>
      <p class="nodata"><%= l(:text_kb_no_pinned_articles_admin) %></p>
    <% end %>
  </main>
</div>

<% html_title l(:label_knowledge_base) %>
